#!/usr/bin/env sh
# Docs-only commits (just CLAUDE.md, the fleet-wide canonical doc sync)
# skip the full check suite below — it has nothing to check.
if [ "$(git diff --cached --name-only)" = "CLAUDE.md" ]; then
  exit 0
fi
set -eu

npm run lint
npm run typecheck
npm run format:check

if command -v gitleaks >/dev/null 2>&1; then
  gitleaks protect --staged --redact
else
  echo 'gitleaks not found; running fallback staged secret scan.'
  scripts/scan-secrets.sh --staged
fi
